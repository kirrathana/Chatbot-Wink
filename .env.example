# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=API_KEY_HERE

# AI Model Configuration (Default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-3.5-flash-lite

# Context Window Configuration (Number of latest messages retained in active prompt)
MAX_CONTEXT_MESSAGES=10

# Flask Server Configuration
FLASK_PORT=5000
FLASK_DEBUG=True

